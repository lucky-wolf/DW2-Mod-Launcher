<Project>

  <!-- MinVer derives <Version> (and AssemblyVersion/FileVersion/InformationalVersion) from the
       nearest reachable "vMAJOR.MINOR.PATCH" git tag - the tags scripts/release.py creates on merge
       to main. Never hand-set a version in a .csproj. Untagged/dev builds get a pre-release
       version (e.g. 0.5.0-alpha.0.7), so they're always distinguishable from a release. -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- .version holds the hand-bumped MAJOR.MINOR that scripts/release.py tags with. Feed it to MinVer as the floor so a
         dev build already shows the version the next release will carry (0.5 -> 0.5.0-dev) instead of lagging at the
         last tag's patch+1 until the first tag of the new MAJOR.MINOR exists. -->
    <DW2VersionFile>$(MSBuildThisFileDirectory).version</DW2VersionFile>
    <MinVerMinimumMajorMinor Condition="Exists('$(DW2VersionFile)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(DW2VersionFile)')), '^\s*(\d+\.\d+)').Groups[1].Value)</MinVerMinimumMajorMinor>
    <!-- Lets non-Windows machines restore/build/format the net10.0-windows projects (no-op on Windows).
         Running the WinForms app still needs Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- MinVer appends "-alpha.0.N" to builds past the latest tag. Drop it so every build, dev or
       release, shows plain MAJOR.MINOR.PATCH: for a dev build that is the version the next release
       will carry (the tag release.py will create), on a tagged build it is the tag itself. Untagged
       builds get "-dev" in the InformationalVersion only, so they stay distinguishable. -->
  <Target Name="StampPlainSemver" AfterTargets="MinVer">
    <PropertyGroup>
      <Version>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch)</Version>
      <PackageVersion>$(Version)</PackageVersion>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion Condition="'$(MinVerPreRelease)' == ''">$(Version)</InformationalVersion>
      <InformationalVersion Condition="'$(MinVerPreRelease)' != ''">$(Version)-dev</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
