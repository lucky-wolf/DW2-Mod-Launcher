<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>DW2ModLauncher.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DW2ModLauncher.Core\DW2ModLauncher.Core.csproj" />
    <ProjectReference Include="..\DW2ModLauncher.XmlPatching\DW2ModLauncher.XmlPatching.csproj" />
    <!-- The Loader has the XmlPatching sources compiled in, so its public types would clash with the XmlPatching project's own;
         the alias keeps the Loader's copy out of the global namespace (files that test Loader types say "extern alias loader;"). -->
    <ProjectReference Include="..\DW2ModLauncher.Loader\DW2ModLauncher.Loader.csproj" Aliases="loader" />
  </ItemGroup>

</Project>
