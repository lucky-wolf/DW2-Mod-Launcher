<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Stays net8.0 on purpose: this DLL is loaded into the game's own process, which runs on .NET 8, so it
         must not target a newer runtime than the game. Everything else in the repo targets net10.0. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DW2ModLauncher.Loader</AssemblyName>
    <RootNamespace>DW2ModLauncher.Loader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The XML patch engine is compiled INTO this DLL (not referenced) so the loader stays the single loose file the launcher
         ships and injects. The same sources are the standalone DW2ModLauncher.XmlPatching project the launcher and tests use. -->
    <Compile Include="..\DW2ModLauncher.XmlPatching\**\*.cs" Exclude="..\DW2ModLauncher.XmlPatching\obj\**;..\DW2ModLauncher.XmlPatching\bin\**" LinkBase="XmlPatching" />

    <!-- Reference assemblies only: at runtime the game's own 0Harmony.dll (2.3.3, next to the game exe) is used, as the mods do. -->
    <PackageReference Include="Lib.Harmony.Ref" Version="2.3.3" />
  </ItemGroup>

</Project>
