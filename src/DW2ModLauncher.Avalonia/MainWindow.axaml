<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DW2ModLauncher.Avalonia.ViewModels"
        xmlns:views="using:DW2ModLauncher.Avalonia.Views"
        x:Class="DW2ModLauncher.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource Dw2Void}" BorderBrush="{StaticResource Dw2BlueGlow}" BorderThickness="0,0,0,2" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="heading" Text="DW2 MOD LAUNCHER" />
          <TextBlock Classes="eyebrow" Text="MOD MANAGEMENT SYSTEM  //  METAPO  //  SERGE  //  MORDACHAI" />
          <!-- Mod profiles -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
            <TextBlock Classes="eyebrow" VerticalAlignment="Center" Text="{Binding L[ModProfiles]}" />
            <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding ProfileName}" Width="200" />
            <TextBlock Text="*" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource Dw2Gold}"
                       IsVisible="{Binding ProfileIsDirty}" ToolTip.Tip="{Binding L[ProfileUnsavedTooltip]}" />
            <Button Content="{Binding L[SaveCurrent]}" Command="{Binding SaveProfileCommand}" />
            <Button Command="{Binding RevertProfileCommand}" ToolTip.Tip="{Binding L[RevertProfile]}">
              <!-- "undo" arrow, Material Design Icons, Apache-2.0 -->
              <PathIcon Width="16" Height="16" Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
            </Button>
            <Button Content="{Binding L[SaveProfileAs]}" Command="{Binding SaveProfileAsCommand}" />
            <Button Content="{Binding L[RenameProfile]}" Command="{Binding RenameProfileCommand}" />
            <Button Content="{Binding L[NewProfile]}" Command="{Binding NewProfileCommand}" />
            <Button Content="{Binding L[Delete]}" Command="{Binding DeleteProfileCommand}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="86" VerticalAlignment="Top">
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="vm:LanguageOption">
                <TextBlock Text="{Binding ShortCode}" />
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
          <Button Command="{Binding OpenSettingsCommand}" Width="46" Height="46" Margin="0,-4,0,0" ToolTip.Tip="{Binding L[Settings]}">
            <!-- "settings" gear, Material Design Icons, Apache-2.0 -->
            <PathIcon Width="22" Height="22" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
          </Button>
          <Button Classes="play" Classes.stop="{Binding IsGameRunning}" Command="{Binding PlayCommand}" ToolTip.Tip="{Binding PlayTooltip}" Width="260" Height="46" Margin="0,-4,0,0" HorizontalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <Arc Classes="spinner" IsVisible="{Binding IsLaunching}" Width="18" Height="18" StartAngle="0" SweepAngle="270" Stroke="{StaticResource Dw2Gold}" StrokeThickness="3" VerticalAlignment="Center" />
              <PathIcon IsVisible="{Binding IsGameIdle}" Width="16" Height="16" Data="M8 5v14l11-7z" VerticalAlignment="Center" />
              <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Pages -->
    <Panel Grid.Row="1" Background="{StaticResource Dw2Panel}">
      <views:ModsView />
    </Panel>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{StaticResource Dw2Void}" Padding="10,6">
      <TextBlock Classes="muted" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- Busy overlay: darkens the whole window and swallows input while a long job runs. -->
    <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsBusy}" Background="#B0000000">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
        <Arc Classes="spinner" Width="56" Height="56" StartAngle="0" SweepAngle="270" Stroke="{StaticResource Dw2Gold}" StrokeThickness="6" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding BusyText}" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
