<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DW2ModLauncher.Avalonia.ViewModels"
        xmlns:svc="using:DW2ModLauncher.Core.Services"
        x:Class="DW2ModLauncher.Avalonia.Views.PublishDialog"
        x:DataType="vm:PublishDialogViewModel"
        Title="{Binding WindowTitle}" Width="830" Height="900" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid RowDefinitions="*,Auto,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="24" Spacing="14">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding L[PublishInfoTitle]}" />
          <TextBox Text="{Binding Title}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding L[PublishShortDescription]}" ToolTip.Tip="{Binding L[PublishShortDescriptionHint]}" />
          <TextBox Text="{Binding ShortDescription}" ToolTip.Tip="{Binding L[PublishShortDescriptionHint]}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding L[PublishTags]}" ToolTip.Tip="{Binding L[PublishTagsHint]}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ItemsControl ItemsSource="{Binding TagChips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TagChip">
                  <Border Background="{StaticResource Dw2Steel}" CornerRadius="12" Padding="10,2,4,2" Margin="0,0,8,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                      <Button Command="{Binding Remove}" Padding="4" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding RemoveTooltip}">
                        <!-- "close" x, Material Design Icons, Apache-2.0 -->
                        <PathIcon Width="10" Height="10" Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Command="{Binding AddTagCommand}" Padding="8,4" VerticalAlignment="Top" ToolTip.Tip="{Binding L[PublishTagAdd]}">
              <!-- "plus" icon, Material Design Icons, Apache-2.0 -->
              <PathIcon Width="12" Height="12" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
            </Button>
          </StackPanel>
        </StackPanel>
        <Grid ColumnDefinitions="Auto,24,*,24,*">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="{Binding L[Version]}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Text="{Binding Version}" Width="140" />
              <!-- Small +/- pairs in major, minor, patch order (tooltips say which); they only act on plain X.Y.Z versions and grey out otherwise. -->
              <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding IsSemver}">
                <StackPanel.Styles>
                  <Style Selector="Button.step">
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="15" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                  </Style>
                  <!-- Exactly 1px down: a margin would only move a centred icon by half that. -->
                  <Style Selector="Button.step PathIcon">
                    <Setter Property="RenderTransform" Value="translateY(1px)" />
                  </Style>
                </StackPanel.Styles>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="+major" ToolTip.Tip="{Binding L[VersionIncMajor]}"><PathIcon Width="9" Height="9" Data="M4 0h2v4h4v2H6v4H4V6H0V4h4z" /></Button>
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="-major" ToolTip.Tip="{Binding L[VersionDecMajor]}"><PathIcon Width="9" Height="9" Data="M0 4h10v2H0z" /></Button>
              </StackPanel>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="+minor" ToolTip.Tip="{Binding L[VersionIncMinor]}"><PathIcon Width="9" Height="9" Data="M4 0h2v4h4v2H6v4H4V6H0V4h4z" /></Button>
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="-minor" ToolTip.Tip="{Binding L[VersionDecMinor]}"><PathIcon Width="9" Height="9" Data="M0 4h10v2H0z" /></Button>
              </StackPanel>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="+patch" ToolTip.Tip="{Binding L[VersionIncPatch]}"><PathIcon Width="9" Height="9" Data="M4 0h2v4h4v2H6v4H4V6H0V4h4z" /></Button>
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="-patch" ToolTip.Tip="{Binding L[VersionDecPatch]}"><PathIcon Width="9" Height="9" Data="M0 4h10v2H0z" /></Button>
              </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Text="{Binding L[VersionOnPublish]}" />
            <ComboBox ItemsSource="{Binding BumpLevels}" SelectedItem="{Binding BumpLevel}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="4" Spacing="6">
            <TextBlock Text="{Binding L[PublishLastPublished]}" />
            <TextBox Text="{Binding LastPublished, Mode=OneWay}" IsReadOnly="True" />
          </StackPanel>
        </Grid>
        <!-- Identity and picture. The unique ID is the mod's permanent identity: read-only, copyable, assigned by the first publish if it has none. -->
        <Grid ColumnDefinitions="1*,16,1*">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="{Binding L[PublishUniqueId]}" />
            <Grid ColumnDefinitions="*,6,Auto">
              <TextBox Grid.Column="0" Text="{Binding UidText, Mode=OneWay}" IsReadOnly="True" />
              <Button Grid.Column="2" Command="{Binding CopyUidCommand}" Padding="10,6" ToolTip.Tip="{Binding L[PublishCopyUniqueId]}">
                <!-- "content copy" icon, Material Design Icons, Apache-2.0 -->
                <PathIcon Width="16" Height="16" Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
              </Button>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding L[PublishInfoPreviewImage]}" />
              <TextBlock Grid.Column="1" Classes="muted" HorizontalAlignment="Right" Text="{Binding PreviewImageSize}" />
            </Grid>
            <!-- The name is read-only (it can still be selected and copied); the folder button opens the file picker. -->
            <Grid ColumnDefinitions="*,6,Auto">
              <TextBox Grid.Column="0" Text="{Binding PreviewImage}" IsReadOnly="True" />
              <Button Grid.Column="2" Command="{Binding BrowsePreviewCommand}" Padding="10,6" ToolTip.Tip="{Binding L[PublishInfoPreviewImage]}">
                <!-- "folder open" icon, Material Design Icons, Apache-2.0 -->
                <PathIcon Width="16" Height="16" Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" />
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
        <!-- Steam only: shown when Steam is enabled and ticked for this publish (always in Edit Properties). -->
        <Grid ColumnDefinitions="1*,16,1*" IsVisible="{Binding ShowSteamFields}">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="{Binding L[PublishWorkshopId]}" />
            <TextBox Text="{Binding WorkshopIdText, Mode=OneWay}" IsReadOnly="True" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Text="{Binding L[PublishVisibility]}" />
            <ComboBox ItemsSource="{Binding Visibilities}" SelectedItem="{Binding Visibility}" IsEnabled="{Binding VisibilityEnabled}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
        <!-- Folded by default: the arrow edits the description here, the pencil in your own editor. The buttons sit in the header and do not toggle it. -->
        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto,*,Auto,6,Auto,6,Auto,6,Auto,6,Auto" ToolTip.Tip="{Binding DescriptionTooltip}">
              <!-- The gold dot is the same "modified" mark as the mod list's; here it means the text differs from the Steam page. -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Text="{Binding DescriptionHeader}" />
                <TextBlock Text="●" VerticalAlignment="Center" Foreground="{StaticResource Dw2Gold}" IsVisible="{Binding ShowDescriptionDiffers}" />
                <!-- Red: the text on Steam is no longer what the launcher last sent, so it was edited on the Steam page. -->
                <TextBlock Text="●" VerticalAlignment="Center" Foreground="{StaticResource Dw2Red}" IsVisible="{Binding ShowDescriptionEditedOnSteam}" />
              </StackPanel>
            <Button Grid.Column="2" Command="{Binding EditDescriptionFileCommand}" Padding="10,6" ToolTip.Tip="{Binding L[PublishEditDescriptionFileTooltip]}">
              <!-- "pencil" icon, Material Design Icons, Apache-2.0 -->
              <PathIcon Width="16" Height="16" Data="M20.71 7.04c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83zM3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z" />
            </Button>
            <Rectangle Grid.Column="6" Width="1" Margin="4,2" Fill="{StaticResource Dw2Steel}" IsVisible="{Binding HasWorkshopId}" />
            <Button Grid.Column="8" IsVisible="{Binding HasWorkshopId}" Command="{Binding OpenSteamPageCommand}" Padding="10,6" ToolTip.Tip="{Binding L[SteamPage]}">
              <!-- "open in new" icon, Material Design Icons, Apache-2.0 (not an eye: eyes mean visibility in the mod list) -->
              <PathIcon Width="16" Height="16" Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" />
            </Button>
            <Button Grid.Column="10" IsVisible="{Binding HasWorkshopId}" Command="{Binding PullSteamDescriptionCommand}" Padding="10,6" ToolTip.Tip="{Binding L[PublishPullSteamDescriptionTooltip]}">
              <!-- "cloud download" icon, Material Design Icons, Apache-2.0 -->
              <PathIcon Width="16" Height="16" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" />
            </Button>
            <Button Grid.Column="4" IsVisible="{Binding HasWorkshopId}" Command="{Binding PushSteamDescriptionCommand}" Padding="10,6" ToolTip.Tip="{Binding L[PublishPushSteamDescriptionTooltip]}">
              <!-- "cloud upload" icon, Material Design Icons, Apache-2.0 -->
              <PathIcon Width="16" Height="16" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z" />
            </Button>
            </Grid>
          </Expander.Header>
          <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="160" />
        </Expander>
        <!-- Rarely used sections stay collapsed (just the title and an arrow) unless the mod actually has something in them. -->
        <Expander Header="{Binding BundlesHeader}" IsExpanded="{Binding HasBundles, Mode=OneTime}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,8,0,0">
          <Border Background="{StaticResource Dw2Void}" BorderBrush="{StaticResource Dw2Steel}" BorderThickness="1" Padding="10,8">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,12,90">
                <TextBlock Grid.Column="0" Classes="eyebrow" Text="{Binding L[PublishBundlesColumnFile]}" />
                <TextBlock Grid.Column="2" Classes="eyebrow" HorizontalAlignment="Right" Text="{Binding L[PublishBundlesColumnSize]}" />
              </Grid>
              <TextBlock Classes="muted" IsVisible="{Binding NoBundles}" Text="{Binding L[PublishBundlesNone]}" />
              <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasBundles}">
                <ItemsControl ItemsSource="{Binding BundleRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BundleRow">
                      <Grid ColumnDefinitions="*,12,90" ToolTip.Tip="{Binding Tooltip}">
                        <TextBlock Grid.Column="0" Foreground="{StaticResource Dw2Gold}" TextWrapping="Wrap" Text="{Binding Name}" IsVisible="{Binding IsPresent}" />
                        <TextBlock Grid.Column="0" Foreground="IndianRed" TextWrapping="Wrap" Text="{Binding Name, StringFormat='⚠ {0}'}" IsVisible="{Binding IsMissing}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Size}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Expander>
        <Expander Header="{Binding InjectedDllsHeader}" IsExpanded="{Binding HasInjectedDlls, Mode=OneTime}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,8,0,0" ToolTip.Tip="{Binding L[PublishInjectedDllsTooltip]}">
          <Border Background="{StaticResource Dw2Void}" BorderBrush="{StaticResource Dw2Steel}" BorderThickness="1" Padding="10,8">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="260,12,*">
                <TextBlock Grid.Column="0" Classes="eyebrow" Text="{Binding L[PublishInjectedDllsColumnDll]}" />
                <TextBlock Grid.Column="2" Classes="eyebrow" Text="{Binding L[PublishInjectedDllsColumnEntry]}" />
              </Grid>
              <TextBlock Classes="muted" IsVisible="{Binding NoInjectedDlls}" Text="{Binding L[PublishInjectedDllsNone]}" />
              <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasInjectedDlls}">
                <ItemsControl ItemsSource="{Binding InjectedDlls}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InjectedDllRow">
                      <Grid ColumnDefinitions="260,12,*" ToolTip.Tip="{Binding Tooltip}">
                        <TextBlock Grid.Column="0" Foreground="{StaticResource Dw2Gold}" TextWrapping="Wrap" Text="{Binding Dll}" IsVisible="{Binding IsValid}" />
                        <TextBlock Grid.Column="0" Foreground="Orange" TextWrapping="Wrap" Text="{Binding Dll, StringFormat='⚠ {0}'}" IsVisible="{Binding IsWarning}" />
                        <TextBlock Grid.Column="0" Foreground="IndianRed" TextWrapping="Wrap" Text="{Binding Dll, StringFormat='⚠ {0}'}" IsVisible="{Binding IsInvalid}" />
                        <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding EntryPoint}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Expander>
        <!-- The mods this one needs or works better with (dw2modlauncher.json "dependencies"). The + adds one; each row sets whether it is required, the load order, the oldest version, and whether the Steam page links it. -->
        <Expander IsExpanded="{Binding HasDependencies, Mode=OneTime}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,8,0,0">
          <Expander.Header>
            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding L[PublishDependenciesTooltip]}">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding DependenciesHeader}" />
              <Button Grid.Column="1" Command="{Binding AddDependencyCommand}" Padding="10,6" ToolTip.Tip="{Binding L[PublishDependencyAdd]}">
                <!-- "plus" icon, Material Design Icons, Apache-2.0 -->
                <PathIcon Width="16" Height="16" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
              </Button>
            </Grid>
          </Expander.Header>
          <Border Background="{StaticResource Dw2Void}" BorderBrush="{StaticResource Dw2Steel}" BorderThickness="1" Padding="10,8">
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" IsVisible="{Binding NoDependencies}" Text="{Binding L[PublishDependencyNone]}" />
              <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasDependencies}">
                <ItemsControl ItemsSource="{Binding DependencyRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DependencyRow">
                      <StackPanel Spacing="4" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource Dw2Gold}" TextWrapping="Wrap" Text="{Binding Name}" />
                          <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="Orange" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                          <Button Grid.Column="2" Command="{Binding Remove}" Padding="6,4" ToolTip.Tip="{Binding RemoveTooltip}">
                            <!-- "close" icon, Material Design Icons, Apache-2.0 -->
                            <PathIcon Width="12" Height="12" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                          </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                          <CheckBox IsChecked="{Binding Required}" Content="{Binding L[PublishDependencyRequired]}" ToolTip.Tip="{Binding L[PublishDependencyRequiredTooltip]}" />
                          <CheckBox IsChecked="{Binding LinkOnSteam}" IsEnabled="{Binding SteamEnabled}" Content="{Binding L[PublishDependencySteamLink]}" ToolTip.Tip="{Binding L[PublishDependencySteamLinkTooltip]}" />
                          <ComboBox Width="190" ItemsSource="{Binding OrderChoices}" SelectedIndex="{Binding OrderIndex}" ToolTip.Tip="{Binding L[PublishDependencyOrderTooltip]}" />
                          <TextBox Width="110" Text="{Binding MinVersion}" PlaceholderText="{Binding L[PublishDependencyMinVersion]}" ToolTip.Tip="{Binding L[PublishDependencyMinVersionTooltip]}" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Expander>
        <!-- The mods this one's author has checked it works with (dw2modlauncher.json "hooksCoordinatedWith"). The + in the header adds one at the version it has now; each row has its own remove button. -->
        <Expander IsExpanded="{Binding HasCompatible, Mode=OneTime}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,8,0,0">
          <Expander.Header>
            <Grid ColumnDefinitions="*,Auto,*,Auto" ToolTip.Tip="{Binding L[PublishCompatibleWithTooltip]}">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding CompatibleHeader}" />
              <!-- caution flag and how many overlapping mods are not marked compatible yet; mid-bar, away from the count and the plus -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding HasCompatibleCaution}" ToolTip.Tip="{Binding CompatibleCautionTooltip}">
                <!-- "alert" icon, Material Design Icons, Apache-2.0 -->
                <PathIcon Width="14" Height="14" Foreground="Orange" Data="M13 14h-2V9h2m0 9h-2v-2h2M1 21h22L12 2 1 21z" />
                <TextBlock Foreground="Orange" Text="{Binding CompatibleCautionCount}" />
              </StackPanel>
              <Button Grid.Column="3" Command="{Binding AddCompatibleCommand}" Padding="10,6" ToolTip.Tip="{Binding L[PublishCompatibleAdd]}">
                <!-- "plus" icon, Material Design Icons, Apache-2.0 -->
                <PathIcon Width="16" Height="16" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
              </Button>
            </Grid>
          </Expander.Header>
          <Border Background="{StaticResource Dw2Void}" BorderBrush="{StaticResource Dw2Steel}" BorderThickness="1" Padding="10,8">
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" IsVisible="{Binding NoCompatible}" Text="{Binding L[PublishCompatibleNone]}" />
              <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasCompatible}">
                <ItemsControl ItemsSource="{Binding CompatibleRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CompatibleRow">
                      <Grid ColumnDefinitions="*,12,110,12,Auto,8,Auto,Auto" Margin="0,2">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource Dw2Gold}" TextWrapping="Wrap" Text="{Binding Name}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Version}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="Orange" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                        <Button Grid.Column="6" Command="{Binding Update}" IsVisible="{Binding CanUpdate}" Padding="6,4" Margin="0,0,4,0" ToolTip.Tip="{Binding UpdateTooltip}">
                          <!-- "check" icon, Material Design Icons, Apache-2.0 -->
                          <PathIcon Width="12" Height="12" Foreground="{StaticResource Dw2Green}" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                        </Button>
                        <Button Grid.Column="7" Command="{Binding Remove}" Padding="6,4" ToolTip.Tip="{Binding RemoveTooltip}">
                          <!-- "close" icon, Material Design Icons, Apache-2.0 -->
                          <PathIcon Width="12" Height="12" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Expander>
        <!-- What the update will send as its change note: the Unreleased lines of changelog.txt. Folded to "Change notes: N" until opened. -->
        <Expander IsVisible="{Binding ShowChangeNotes}" IsExpanded="{Binding ChangeNotesExpanded}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0">
          <Expander.Header>
            <TextBlock Text="{Binding ChangeNotesHeader}" ToolTip.Tip="{Binding L[PublishChangeNotesHint]}" />
          </Expander.Header>
          <TextBox Text="{Binding ChangeNotes}" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" MinLines="{Binding ChangeNotesLines}" MaxLines="{Binding ChangeNotesLines}" />
        </Expander>
        <!-- Folded to the one status line by default; the choice is remembered. Unfolded it lists every changed file. -->
        <Expander IsVisible="{Binding HasPublishStatus}" IsExpanded="{Binding StatusExpanded}" Header="{Binding PublishStatusLine}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,4,0,0">
          <SelectableTextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding PublishStatusDetail}" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <!-- Where this publish goes, fixed above the buttons so the choice and the Publish button stay together. In Edit Properties (no targets) only the repository box shows. -->
    <Border Grid.Row="1" Background="{StaticResource Dw2Panel}" BorderBrush="{StaticResource Dw2Steel}" BorderThickness="0,1,0,0" Padding="24,10" IsVisible="{Binding ShowPublishStrip}">
      <StackPanel Spacing="6">
        <!-- The repository box takes all the width left of the checkboxes; the border's 24 px padding keeps the margins equal on both sides. -->
        <Grid ColumnDefinitions="Auto,Auto,*">
          <TextBlock Grid.Column="0" Margin="0,0,24,0" IsVisible="{Binding ShowTargets}" VerticalAlignment="Center" Text="{Binding L[PublishTo]}" />
          <CheckBox Grid.Column="1" Margin="0,0,24,0" IsVisible="{Binding ShowSteamTarget}" IsChecked="{Binding ToSteam}" Content="{Binding L[SettingsPublishToSteam]}" ToolTip.Tip="{Binding L[PublishToSteamHint]}" />
          <!-- The colon makes the box double as the repository's label: tick it, then fill in the repository after it. -->
          <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <CheckBox Grid.Column="0" IsVisible="{Binding ShowGitHubTarget}" IsChecked="{Binding ToGitHub}" Content="{Binding L[SettingsPublishToGitHub], StringFormat='{}{0}:'}" ToolTip.Tip="{Binding L[PublishToGitHubHint]}" />
            <!-- Edit Properties has no box to double as the label, so the repository is named there. -->
            <TextBlock Grid.Column="1" IsVisible="{Binding !ShowTargets}" VerticalAlignment="Center" Text="{Binding L[PublishReleaseRepo]}" ToolTip.Tip="{Binding L[PublishReleaseRepoHint]}" />
            <TextBox Grid.Column="2" IsVisible="{Binding ShowReleaseRepo}" Text="{Binding ReleaseRepo}" PlaceholderText="owner/name" ToolTip.Tip="{Binding L[PublishReleaseRepoHint]}" />
          </Grid>
        </Grid>
        <TextBlock IsVisible="{Binding ReleaseRepoInvalid}" Text="{Binding L[PublishReleaseRepoInvalid]}" Foreground="Orange" TextWrapping="Wrap" />
        <TextBlock IsVisible="{Binding HasBlockedReason}" Text="{Binding PublishBlockedReason}" Foreground="Orange" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <!-- The footer is at the window's bottom edge: a tooltip below its buttons has no room and ends up over the pointer, taking the click.
         These two open above the button instead. ToolTip.VerticalOffset defaults to +20 and applies to every placement (it pushed a Top tooltip down over its own button), hence the explicit offset. -->
    <Border Grid.Row="2" Background="{StaticResource Dw2Void}" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
        <Button IsVisible="{Binding CanMarkUpToDate}" Command="{Binding MarkUpToDateCommand}" Content="{Binding L[MarkUpToDate]}" MinWidth="125" ToolTip.Tip="{Binding L[MarkUpToDateTooltip]}" ToolTip.Placement="Top" ToolTip.VerticalOffset="-8" ToolTip.HorizontalOffset="0" />
        <Button IsVisible="{Binding ShowSave}" IsEnabled="{Binding CanSave}" Command="{Binding SaveCommand}" Content="{Binding L[Save]}" MinWidth="125" />
        <Button Name="PublishButton" Classes="play" IsEnabled="{Binding CanPrimary}" Content="{Binding PrimaryButtonText}" MinWidth="170" FontSize="14" ToolTip.Tip="{Binding PublishTooltip}" ToolTip.Placement="Top" ToolTip.VerticalOffset="-8" ToolTip.HorizontalOffset="0" />
        <Button Name="CancelButton" IsCancel="True" IsVisible="{Binding ShowCancel}" Content="{Binding CancelText}" MinWidth="125" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
