<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DW2ModLauncher.Avalonia.ViewModels"
        xmlns:svc="using:DW2ModLauncher.Core.Services"
        x:Class="DW2ModLauncher.Avalonia.Views.PublishDialog"
        x:DataType="vm:PublishDialogViewModel"
        Title="{Binding WindowTitle}" Width="720" Height="900" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="24" Spacing="14">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding L[PublishInfoTitle]}" />
          <TextBox Text="{Binding Title}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,16,*,16,*">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="{Binding L[PublishWorkshopId]}" />
            <TextBox Text="{Binding WorkshopIdText, Mode=OneWay}" IsReadOnly="True" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Text="{Binding L[PublishVisibility]}" />
            <ComboBox ItemsSource="{Binding Visibilities}" SelectedItem="{Binding Visibility}" IsEnabled="{Binding CanEditVisibility}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="4" Spacing="6">
            <TextBlock Text="{Binding L[PublishInfoPreviewImage]}" />
            <Grid ColumnDefinitions="*,6,Auto">
              <TextBox Grid.Column="0" Text="{Binding PreviewImage}" />
              <Button Grid.Column="2" Content="…" Command="{Binding BrowsePreviewCommand}" MinWidth="36" />
            </Grid>
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="Auto,24,*">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="{Binding L[Version]}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Text="{Binding Version}" Width="140" />
              <!-- Small +/- pairs in major, minor, patch order (tooltips say which); they only act on plain X.Y.Z versions and grey out otherwise. -->
              <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding IsSemver}">
                <StackPanel.Styles>
                  <Style Selector="Button.step">
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="15" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                  </Style>
                  <!-- Exactly 1px down: a margin would only move a centred icon by half that. -->
                  <Style Selector="Button.step PathIcon">
                    <Setter Property="RenderTransform" Value="translateY(1px)" />
                  </Style>
                </StackPanel.Styles>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="+major" ToolTip.Tip="{Binding L[VersionIncMajor]}"><PathIcon Width="9" Height="9" Data="M4 0h2v4h4v2H6v4H4V6H0V4h4z" /></Button>
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="-major" ToolTip.Tip="{Binding L[VersionDecMajor]}"><PathIcon Width="9" Height="9" Data="M0 4h10v2H0z" /></Button>
              </StackPanel>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="+minor" ToolTip.Tip="{Binding L[VersionIncMinor]}"><PathIcon Width="9" Height="9" Data="M4 0h2v4h4v2H6v4H4V6H0V4h4z" /></Button>
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="-minor" ToolTip.Tip="{Binding L[VersionDecMinor]}"><PathIcon Width="9" Height="9" Data="M0 4h10v2H0z" /></Button>
              </StackPanel>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="+patch" ToolTip.Tip="{Binding L[VersionIncPatch]}"><PathIcon Width="9" Height="9" Data="M4 0h2v4h4v2H6v4H4V6H0V4h4z" /></Button>
                <Button Classes="step" Command="{Binding AdjustVersionCommand}" CommandParameter="-patch" ToolTip.Tip="{Binding L[VersionDecPatch]}"><PathIcon Width="9" Height="9" Data="M0 4h10v2H0z" /></Button>
              </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Text="{Binding L[VersionOnPublish]}" />
            <ComboBox ItemsSource="{Binding BumpLevels}" SelectedItem="{Binding BumpLevel}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding L[PublishShortDescription]}" />
          <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding L[PublishShortDescriptionHint]}" />
          <TextBox Text="{Binding ShortDescription}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto,6,Auto,6,Auto,6,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding L[Description]}" />
            <Button Grid.Column="4" Command="{Binding EditDescriptionFileCommand}" Padding="10,6" ToolTip.Tip="{Binding L[PublishEditDescriptionFileTooltip]}">
              <!-- "pencil" icon, Material Design Icons, Apache-2.0 -->
              <PathIcon Width="16" Height="16" Data="M20.71 7.04c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83zM3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z" />
            </Button>
            <Button Grid.Column="8" IsVisible="{Binding HasWorkshopId}" Command="{Binding OpenSteamPageCommand}" Padding="10,6" ToolTip.Tip="{Binding L[SteamPage]}">
              <!-- "eye" icon, Material Design Icons, Apache-2.0 -->
              <PathIcon Width="16" Height="16" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
            </Button>
            <Button Grid.Column="2" IsVisible="{Binding HasWorkshopId}" Command="{Binding PullSteamDescriptionCommand}" Padding="10,6" ToolTip.Tip="{Binding L[PublishPullSteamDescriptionTooltip]}">
              <!-- "cloud download" icon, Material Design Icons, Apache-2.0 -->
              <PathIcon Width="16" Height="16" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" />
            </Button>
            <Button Grid.Column="6" IsVisible="{Binding HasWorkshopId}" Command="{Binding PushSteamDescriptionCommand}" Padding="10,6" ToolTip.Tip="{Binding L[PublishPushSteamDescriptionTooltip]}">
              <!-- "cloud upload" icon, Material Design Icons, Apache-2.0 -->
              <PathIcon Width="16" Height="16" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z" />
            </Button>
          </Grid>
          <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding L[PublishDescriptionHint]}" />
          <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="160" />

        </StackPanel>
        <!-- Rarely used sections stay collapsed (just the title and an arrow) unless the mod actually has something in them. -->
        <Expander Header="{Binding L[PublishInfoBundles]}" IsExpanded="{Binding HasBundles, Mode=OneTime}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,8,0,0">
          <TextBox Text="{Binding Bundles}" AcceptsReturn="True" Height="62" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Expander>
        <Expander Header="{Binding L[PublishInjectedDlls]}" IsExpanded="{Binding HasInjectedDlls, Mode=OneTime}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,8,0,0" ToolTip.Tip="{Binding L[PublishInjectedDllsTooltip]}">
          <Border Background="{StaticResource Dw2Void}" BorderBrush="{StaticResource Dw2Steel}" BorderThickness="1" Padding="10,8">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="260,12,*">
                <TextBlock Grid.Column="0" Classes="eyebrow" Text="{Binding L[PublishInjectedDllsColumnDll]}" />
                <TextBlock Grid.Column="2" Classes="eyebrow" Text="{Binding L[PublishInjectedDllsColumnEntry]}" />
              </Grid>
              <TextBlock Classes="muted" IsVisible="{Binding NoInjectedDlls}" Text="{Binding L[PublishInjectedDllsNone]}" />
              <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasInjectedDlls}">
                <ItemsControl ItemsSource="{Binding InjectedDlls}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:InjectionTarget">
                      <Grid ColumnDefinitions="260,12,*">
                        <TextBlock Grid.Column="0" Foreground="{StaticResource Dw2Gold}" TextWrapping="Wrap" Text="{Binding Dll}" />
                        <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding EntryPoint}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="{StaticResource Dw2Void}" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
        <TextBlock Classes="muted" VerticalAlignment="Center" IsVisible="{Binding ShowDescriptionDiffers}" Text="{Binding L[PublishDescriptionDiffers]}" />
        <CheckBox IsChecked="{Binding ReplaceDescription}" IsVisible="{Binding ShowReplaceDescription}" Content="{Binding L[PublishReplaceDescription]}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Name="PublishButton" Classes="play" IsEnabled="{Binding CanPrimary}" Content="{Binding PrimaryButtonText}" MinWidth="170" FontSize="14" ToolTip.Tip="{Binding Note}" />
        <Button Name="CancelButton" IsCancel="True" Content="{Binding L[Cancel]}" MinWidth="125" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
