<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DW2ModLauncher.Avalonia.ViewModels"
             x:Class="DW2ModLauncher.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="26" Spacing="14" Width="830" HorizontalAlignment="Left">
      <TextBlock Classes="heading" Text="{Binding L[PathsAndLaunchSettings]}" />

      <Grid ColumnDefinitions="170,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="DW2 Game Root" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GameRoot}" />
        <Button Grid.Row="0" Grid.Column="2" Content="…" Command="{Binding BrowseGameCommand}" MinWidth="50" />
        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Workshop Root" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkshopRoot}" />
        <Button Grid.Row="1" Grid.Column="2" Content="…" Command="{Binding BrowseWorkshopCommand}" MinWidth="50" />
        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="DW2 Mod Root" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ManagedRoot}" />
        <Button Grid.Row="2" Grid.Column="2" Content="…" Command="{Binding BrowseManagedCommand}" MinWidth="50" />
        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Log Folder" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LogFolder}" Watermark="blank = DW2's data/Logs folder" />
        <Button Grid.Row="3" Grid.Column="2" Content="…" Command="{Binding BrowseLogFolderCommand}" MinWidth="50" />
        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{Binding L[SettingsDescriptionExtension]}" ToolTip.Tip="{Binding L[SettingsDescriptionExtensionTooltip]}" />
        <ComboBox Grid.Row="4" Grid.Column="1" IsEditable="True" HorizontalAlignment="Left" Width="200" ItemsSource="{Binding DescriptionExtensions}" Text="{Binding DescriptionExtension}" ToolTip.Tip="{Binding L[SettingsDescriptionExtensionTooltip]}" />
      </Grid>

      <StackPanel Spacing="6">
        <TextBlock Text="{Binding L[EffectiveLaunchCommand]}" />
        <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 MinHeight="70" Foreground="{StaticResource Dw2BlueGlow}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
