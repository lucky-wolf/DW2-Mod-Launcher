<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DW2ModLauncher.Avalonia.ViewModels"
             x:Class="DW2ModLauncher.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="26" Spacing="22" Width="830" HorizontalAlignment="Left">

      <!-- Where things are -->
      <StackPanel Spacing="10">
        <Border BorderBrush="{StaticResource Dw2Steel}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="subheading" VerticalAlignment="Center" Text="{Binding L[SettingsSectionPaths]}" />
            <Button Grid.Column="1" Content="{Binding L[AutoDetect]}" Command="{Binding AutoDetectCommand}" ToolTip.Tip="{Binding L[AutoDetectTooltip]}" MinWidth="125" />
          </Grid>
        </Border>
        <Grid ColumnDefinitions="170,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{Binding L[SettingsGameRoot]}" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GameRoot}" />
          <Button Grid.Row="0" Grid.Column="2" Content="…" Command="{Binding BrowseGameCommand}" MinWidth="50" />
          <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{Binding L[SettingsWorkshopRoot]}" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkshopRoot}" />
          <Button Grid.Row="1" Grid.Column="2" Content="…" Command="{Binding BrowseWorkshopCommand}" MinWidth="50" />
          <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{Binding L[SettingsModRoot]}" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ManagedRoot}" />
          <Button Grid.Row="2" Grid.Column="2" Content="…" Command="{Binding BrowseManagedCommand}" MinWidth="50" />
          <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="{Binding L[SettingsLogFolder]}" />
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LogFolder}" PlaceholderText="{Binding L[SettingsLogFolderPlaceholder]}" />
          <Button Grid.Row="3" Grid.Column="2" Content="…" Command="{Binding BrowseLogFolderCommand}" MinWidth="50" />
        </Grid>
      </StackPanel>

      <!-- How the game is started -->
      <StackPanel Spacing="10">
        <Border BorderBrush="{StaticResource Dw2Steel}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
          <TextBlock Classes="subheading" Text="{Binding L[SettingsSectionLaunch]}" />
        </Border>
        <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding L[SettingsWidgetLanguage]}" ToolTip.Tip="{Binding L[SettingsWidgetLanguageTooltip]}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24">
            <RadioButton GroupName="WidgetLanguage" IsChecked="{Binding WidgetLanguageFromMods}" Content="{Binding L[SettingsWidgetLanguageFromMods]}" ToolTip.Tip="{Binding L[SettingsWidgetLanguageTooltip]}" />
            <RadioButton GroupName="WidgetLanguage" IsChecked="{Binding WidgetLanguageFromLauncher}" Content="{Binding L[SettingsWidgetLanguageFromLauncher]}" ToolTip.Tip="{Binding L[SettingsWidgetLanguageTooltip]}" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="170,*" IsVisible="{Binding ShowGameMonitor}" ColumnSpacing="10">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding L[SettingsGameMonitor]}" ToolTip.Tip="{Binding L[SettingsGameMonitorTooltip]}" />
          <!-- As wide as the path boxes above: the right margin is the width of their browse button plus the gap -->
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,60,0" ItemsSource="{Binding GameMonitorChoices}" SelectedIndex="{Binding GameMonitorIndex}" ToolTip.Tip="{Binding L[SettingsGameMonitorTooltip]}" />
        </Grid>
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
          <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding AutoSaveProfileOnLaunch}" Content="{Binding L[SettingsAutoSaveProfileOnLaunch]}" ToolTip.Tip="{Binding L[SettingsAutoSaveProfileOnLaunchTooltip]}" />
          <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding AutoSaveProfileOnExit}" Content="{Binding L[SettingsAutoSaveProfileOnExit]}" ToolTip.Tip="{Binding L[SettingsAutoSaveProfileOnExitTooltip]}" />
          <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding ClearCrashIndication}" Content="{Binding L[SettingsClearCrashIndication]}" ToolTip.Tip="{Binding L[SettingsClearCrashIndicationTooltip]}" />
          <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding SteamHelperProcess}" Content="{Binding L[SettingsSteamHelperProcess]}" ToolTip.Tip="{Binding L[SettingsSteamHelperProcessTooltip]}" />
          <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding SkipSplash}" Content="{Binding L[SettingsSkipSplash]}" ToolTip.Tip="{Binding L[SettingsSkipSplashTooltip]}" />
        </Grid>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding L[EffectiveLaunchCommand]}" />
          <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                   MinHeight="70" Foreground="{StaticResource Dw2BlueGlow}" />
        </StackPanel>
      </StackPanel>

      <!-- For people who make mods -->
      <StackPanel Spacing="10">
        <Border BorderBrush="{StaticResource Dw2Steel}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
          <TextBlock Classes="subheading" Text="{Binding L[SettingsSectionAuthoring]}" />
        </Border>
        <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{Binding L[SettingsAuthorName]}" ToolTip.Tip="{Binding L[SettingsAuthorNameTooltip]}" />
          <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="300" Text="{Binding AuthorName}" ToolTip.Tip="{Binding L[SettingsAuthorNameTooltip]}" />
          <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{Binding L[SettingsDescriptionExtension]}" ToolTip.Tip="{Binding L[SettingsDescriptionExtensionTooltip]}" />
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*">
            <ComboBox Grid.Column="0" IsEditable="True" Width="200" ItemsSource="{Binding DescriptionExtensions}" Text="{Binding DescriptionExtension}" ToolTip.Tip="{Binding L[SettingsDescriptionExtensionTooltip]}" />
            <CheckBox Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding AutoUpdateDescription}" Content="{Binding L[SettingsAutoUpdateDescription]}" ToolTip.Tip="{Binding L[SettingsAutoUpdateDescriptionTooltip]}" />
          </Grid>
          <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{Binding L[SettingsOpenSteamPage]}" ToolTip.Tip="{Binding L[SettingsOpenSteamPageTooltip]}" />
          <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="200" ItemsSource="{Binding OpenSteamPageChoices}" SelectedIndex="{Binding OpenSteamPageIndex}" ToolTip.Tip="{Binding L[SettingsOpenSteamPageTooltip]}" />
        </Grid>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
