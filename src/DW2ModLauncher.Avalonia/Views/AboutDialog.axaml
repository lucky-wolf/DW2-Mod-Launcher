<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DW2ModLauncher.Avalonia.ViewModels"
        x:Class="DW2ModLauncher.Avalonia.Views.AboutDialog"
        x:DataType="vm:MainViewModel"
        Title="{Binding L[AboutTitle]}" SizeToContent="Height" Width="520" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid RowDefinitions="*,Auto">
    <StackPanel Grid.Row="0" Margin="26" Spacing="12">
      <TextBlock Classes="heading" Text="DW2 MOD LAUNCHER" />
      <TextBlock Name="VersionText" Classes="eyebrow" />
      <TextBlock TextWrapping="Wrap" Text="{Binding L[AboutDescription]}" />
      <Button Name="ReleasesButton" Classes="link" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0"
              ToolTip.Tip="{Binding L[AboutReleasesTooltip]}">
        <TextBlock Name="ReleasesLink" TextDecorations="Underline" Foreground="{StaticResource Dw2BlueGlow}" />
      </Button>
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding L[AboutDisclaimer]}" />
    </StackPanel>
    <Border Grid.Row="1" Background="{StaticResource Dw2Void}" Padding="16,12">
      <Button Name="CloseButton" IsCancel="True" IsDefault="True" Content="{Binding L[Close]}" MinWidth="125" HorizontalAlignment="Right" />
    </Border>
  </Grid>
</Window>
