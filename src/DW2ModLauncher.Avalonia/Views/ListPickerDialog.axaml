<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DW2ModLauncher.Avalonia.Views.ListPickerDialog"
        Width="640" Height="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
    <TextBlock Name="NoteText" Classes="muted" TextWrapping="Wrap" />
    <ListBox Name="Items" Grid.Row="1" Background="{StaticResource Dw2Deep}" />
  </Grid>
</Window>
