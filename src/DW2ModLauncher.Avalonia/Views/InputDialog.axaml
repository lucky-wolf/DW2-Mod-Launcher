<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DW2ModLauncher.Avalonia.Views.InputDialog"
        SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">
  <StackPanel Margin="20" Spacing="8">
    <TextBlock Name="LabelText" />
    <TextBox Name="InputBox" />
    <TextBlock Name="HintText" Classes="muted" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
      <Button Name="OkButton" MinWidth="90" />
      <Button Name="CancelButton" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
