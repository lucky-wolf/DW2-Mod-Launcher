<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DW2ModLauncher.Avalonia.ViewModels"
        x:Class="DW2ModLauncher.Avalonia.Views.ModSettingsDialog"
        x:DataType="vm:ModSettingsEditorViewModel"
        Title="{Binding Title}" Width="980" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Styles>
    <!-- Ladder matrix cells: filled up to the row's threshold; the shipped setting's column carries a gold underline. -->
    <Style Selector="Button.ladderCell">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.ladderCell.on">
      <Setter Property="Background" Value="{StaticResource Dw2BlueGlow}" />
    </Style>
    <Style Selector="Button.ladderCell.default">
      <Setter Property="BorderBrush" Value="{StaticResource Dw2Gold}" />
    </Style>
  </Window.Styles>
  <Window.Resources>
    <DataTemplate x:Key="LadderRowTemplate" x:DataType="vm:LadderRowViewModel">
      <Grid ColumnDefinitions="260,Auto,Auto" Margin="0,0,0,4" Background="Transparent" ToolTip.Tip="{Binding Field.Tooltip}">
        <TextBlock Grid.Column="0" Foreground="{StaticResource Dw2Gold}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" Text="{Binding Field.Label}" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LadderCellViewModel">
              <Button Classes="ladderCell" Classes.on="{Binding IsOn}" Classes.default="{Binding IsDefault}"
                      Command="{Binding ClickCommand}" ToolTip.Tip="{Binding Tooltip}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Reset to default: same "undo" icon as the plain field rows. -->
        <Button Grid.Column="2" Margin="6,0,0,0" Padding="6,5" Width="30" Height="30" IsEnabled="{Binding Field.CanReset}"
                Command="{Binding Field.ResetCommand}" ToolTip.Tip="{Binding Field.ResetTooltip}">
          <PathIcon Width="14" Height="14" Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
        </Button>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LadderTemplate" x:DataType="vm:LadderViewModel">
      <StackPanel Margin="0,0,0,4">
        <!-- Column headings: short text, the full option as a tooltip. -->
        <Grid ColumnDefinitions="260,Auto" Margin="0,0,0,4">
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LadderColumn">
                <TextBlock Width="64" Margin="0,0,4,0" TextAlignment="Center" Opacity="0.85" Text="{Binding Heading}" ToolTip.Tip="{Binding Tooltip}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource LadderRowTemplate}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="FieldTemplate" x:DataType="vm:SettingFieldViewModel">
              <Grid ColumnDefinitions="*,230,Auto" Margin="0,0,16,6" Background="Transparent" ToolTip.Tip="{Binding Tooltip}">
                <TextBlock Grid.Column="0" Foreground="{StaticResource Dw2Gold}" TextWrapping="Wrap" Margin="0,6,10,0" Text="{Binding Label}" />
                <Panel Grid.Column="1" VerticalAlignment="Top">
                  <CheckBox IsVisible="{Binding IsBool}" IsChecked="{Binding BoolValue}" />
                  <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding ChoiceOptions}" SelectedItem="{Binding SelectedChoice}" HorizontalAlignment="Stretch" />
                  <NumericUpDown IsVisible="{Binding IsNumber}" Value="{Binding NumberValue}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                 Increment="{Binding Increment}" FormatString="{Binding NumberFormat}" HorizontalAlignment="Stretch" />
                  <Grid IsVisible="{Binding IsTextBox}" ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Classes.invalid="{Binding IsInvalid}" Text="{Binding TextValue}" ToolTip.Tip="{Binding PathProblemText}" />
                    <Button Grid.Column="1" Content="&#8230;" Command="{Binding BrowseCommand}" IsVisible="{Binding IsPath}" Margin="6,0,0,0" MinWidth="40" />
                  </Grid>
                </Panel>
                <!-- Reset to default: shown for fields with a schema default, enabled once the value differs. "undo" icon, Material Design Icons, Apache-2.0 -->
                <Button Grid.Column="2" VerticalAlignment="Top" Margin="6,0,0,0" Padding="6,5" Width="30" Height="30" IsVisible="{Binding HasDefault}"
                        IsEnabled="{Binding CanReset}" Command="{Binding ResetCommand}" ToolTip.Tip="{Binding ResetTooltip}">
                  <PathIcon Width="14" Height="14" Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
                </Button>
              </Grid>
    </DataTemplate>
    <DataTemplate x:Key="GroupTemplate" x:DataType="vm:SettingGroupViewModel">
      <StackPanel Spacing="6" Margin="0,0,0,14">
        <Grid IsVisible="{Binding HasHeading}" ColumnDefinitions="Auto,12,*,12,Auto">
          <Button Grid.Column="0" Command="{Binding ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0,2" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="eyebrow" VerticalAlignment="Center" Width="12" Text="{Binding Chevron}" />
              <TextBlock Classes="eyebrow" VerticalAlignment="Center" Text="{Binding DisplayHeading}" />
            </StackPanel>
          </Button>
          <Separator Grid.Column="2" VerticalAlignment="Center" />
          <!-- Reset the whole group to schema defaults; live while any field in it differs. Same "undo" icon as the per-field button. -->
          <Button Grid.Column="4" VerticalAlignment="Center" Padding="4,2" Width="22" Height="20" MinHeight="0" MinWidth="0"
                  IsEnabled="{Binding CanReset}" Command="{Binding ResetGroupCommand}" ToolTip.Tip="{Binding ResetTooltip}">
            <PathIcon Width="10.5" Height="10.5" Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
          </Button>
        </Grid>
        <TextBlock IsVisible="{Binding ShowDescription}" Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,0,16,4" />
        <ContentControl IsVisible="{Binding ShowLadder}" Content="{Binding Ladder}" ContentTemplate="{StaticResource LadderTemplate}" />
        <ItemsControl IsVisible="{Binding ShowFieldList}" ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Name="Scroller" Grid.Row="0">
      <StackPanel Margin="16" Spacing="4">
        <ItemsControl ItemsSource="{Binding VisibleGroups}" ItemTemplate="{StaticResource GroupTemplate}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="{StaticResource Dw2Void}" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto">
        <CheckBox Grid.Column="0" IsVisible="{Binding CanShowHidden}" IsChecked="{Binding ShowHidden}" Content="{Binding L[ModSettingsShowHidden]}"
                  FontSize="11" Opacity="0.75" VerticalAlignment="Center" HorizontalAlignment="Left" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <Button Name="SaveButton" IsEnabled="{Binding CanSave}" Content="{Binding L[Save]}" MinWidth="125" />
        <Button Name="CancelButton" IsCancel="True" Content="{Binding L[Cancel]}" MinWidth="125" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
