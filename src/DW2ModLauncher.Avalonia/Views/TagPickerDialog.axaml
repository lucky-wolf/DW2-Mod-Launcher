<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:DW2ModLauncher.Avalonia.Views"
        x:Class="DW2ModLauncher.Avalonia.Views.TagPickerDialog"
        Width="460" Height="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
    <TextBlock Name="NoteText" Classes="muted" TextWrapping="Wrap" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Name="SearchBox" />
      <Button Name="AddButton" Grid.Column="1" MinWidth="80" IsEnabled="False" />
    </Grid>
    <ListBox Name="Matches" Grid.Row="2" Background="{StaticResource Dw2Deep}" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="v:TagPickRow">
          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Text}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Name="OkButton" MinWidth="100" IsDefault="True" />
      <Button Name="CancelButton" MinWidth="100" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
