<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DW2ModLauncher.Avalonia.Views.RenameDialog"
        SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">
  <StackPanel Margin="20" Spacing="8">
    <TextBlock Name="IntroText" TextWrapping="Wrap" />
    <TextBlock Name="TitleLabel" Margin="0,6,0,0" />
    <TextBox Name="TitleBox" />
    <TextBlock Name="FolderLabel" Margin="0,6,0,0" />
    <TextBox Name="FolderBox" />
    <TextBlock Name="HintText" Classes="muted" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
      <Button Name="OkButton" MinWidth="90" />
      <Button Name="CancelButton" IsCancel="True" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
