<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DW2ModLauncher.Avalonia.ViewModels"
             x:Class="DW2ModLauncher.Avalonia.Views.ModsView"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="7*,Auto,3*" Margin="14">

    <!-- List -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
        <Button Grid.Column="0" Command="{Binding RefreshCommand}" Margin="0,0,10,0" ToolTip.Tip="{Binding L[RefreshModsTooltip]}">
          <!-- "sync" icon (two circular arrows), Material Design Icons, Apache-2.0 -->
          <PathIcon Width="16" Height="16" Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" />
        </Button>
        <TextBlock Grid.Column="1" Classes="subheading" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding L[DragRowsToChangeLoadOrder]}" />
        <Button Grid.Column="2" Command="{Binding CreateModCommand}" Content="{Binding L[CreateMod]}" Margin="10,0,0,0" />
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="44,*,150,100,125" Background="{StaticResource Dw2Steel}">
        <Button Classes="header" Grid.Column="0" Command="{Binding SortCommand}" CommandParameter="4" Content="#" ToolTip.Tip="{Binding L[LoadOrder]}" />
        <Button Classes="header" Grid.Column="1" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="0" Content="{Binding L[ModName]}" Padding="10,6" />
        <Button Classes="header" Grid.Column="2" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="1" Content="{Binding L[Source]}" />
        <Button Classes="header" Grid.Column="3" Command="{Binding SortCommand}" CommandParameter="2" Content="{Binding L[ModState]}" />
        <Button Classes="header" Grid.Column="4" Command="{Binding SortCommand}" CommandParameter="3" Content="{Binding L[Health]}" />
      </Grid>

      <Grid Grid.Row="2">
        <ListBox Name="ModList" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedRow}"
                 Background="{StaticResource Dw2Deep}">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{Binding L[SteamPage]}" Command="{Binding OpenSteamPageCommand}" />
              <MenuItem Header="{Binding L[ModSettings]}" Command="{Binding ModSettingsCommand}" />
              <MenuItem Header="{Binding L[SelectedModFolder]}" Command="{Binding OpenSelectedFolderCommand}" />
              <MenuItem Header="{Binding L[OpenDocs]}" Command="{Binding OpenDocsCommand}" />
              <MenuItem Header="{Binding L[PublishToWorkshop]}" Command="{Binding PublishCommand}" />
              <MenuItem Header="{Binding L[DeleteMod]}" Command="{Binding DeleteModCommand}" />
              <Separator />
              <MenuItem Header="{Binding L[CheckUpdates]}" Command="{Binding CheckUpdatesCommand}" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModRowViewModel">
              <Grid ColumnDefinitions="44,*,150,100,125" MinHeight="54">
                <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Dw2Gold}" Text="{Binding LoadOrder}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="4,0">
                  <Image Source="{Binding Thumbnail}" Width="72" Height="48" Stretch="Uniform" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="6,0" VerticalAlignment="Center" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                <Button Classes="glyph" Classes.on="{Binding Enabled}" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding ToggleCommand}" CommandParameter="{Binding}" Content="{Binding StateGlyph}" />
                <TextBlock Grid.Column="4" Classes="health" Classes.conflict="{Binding IsConflict}" Classes.caution="{Binding IsCaution}" Classes.ok="{Binding IsOk}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Health}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- Drag layer: the ghost of the row being dragged and the insertion line; never hit-tested. -->
        <Canvas Name="DragLayer" IsHitTestVisible="False" ClipToBounds="True">
          <Border Name="Ghost" IsVisible="False" Opacity="0.85" Background="{StaticResource Dw2Panel}"
                  BorderBrush="{StaticResource Dw2Gold}" BorderThickness="1">
            <Image Name="GhostImage" Stretch="None" />
          </Border>
          <Border Name="DropLine" IsVisible="False" Height="2" CornerRadius="1" Background="White" />
        </Canvas>
      </Grid>
    </Grid>

    <GridSplitter Grid.Column="1" Width="8" Background="Transparent" ResizeDirection="Columns" />

    <!-- Details -->
    <Border Grid.Column="2" Background="{StaticResource Dw2PanelAlt}" BorderBrush="{StaticResource Dw2Blue}" BorderThickness="1" Padding="14">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Border Name="PreviewBorder" Grid.Row="0" Background="{StaticResource Dw2Void}" Height="240">
          <Image Source="{Binding Preview}" Stretch="Uniform" Cursor="Hand" />
        </Border>
        <TextBlock Grid.Row="1" Classes="subheading" Margin="0,14,0,8" TextTrimming="CharacterEllipsis" Text="{Binding DetailTitle}" />
        <Border Grid.Row="2" IsVisible="{Binding HasProblems}" Classes="problems" Classes.conflict="{Binding ProblemsIsConflict}" Padding="10,8" Margin="0,0,0,8">
          <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding ProblemsText}" Foreground="{Binding $parent[Border].Tag}" />
        </Border>
        <ScrollViewer Grid.Row="3">
          <SelectableTextBlock TextWrapping="Wrap" Foreground="{StaticResource Dw2Muted}" Text="{Binding DetailText}" />
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
