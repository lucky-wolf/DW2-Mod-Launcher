<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DW2ModLauncher.Avalonia.ViewModels"
             x:Class="DW2ModLauncher.Avalonia.Views.ModsView"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="7*,Auto,3*" Margin="14">

    <!-- List -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
      <WrapPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
        <Button Content="{Binding L[SelectedModFolder]}" Command="{Binding OpenSelectedFolderCommand}" Margin="0,0,8,6" />
        <Button Content="{Binding L[ModSettings]}" Command="{Binding ModSettingsCommand}" Margin="0,0,8,6" />
        <Button Content="{Binding L[OpenDocs]}" Command="{Binding OpenDocsCommand}" Margin="0,0,8,6" />
        <Button Content="{Binding L[CheckUpdates]}" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,6" />
        <Button Content="{Binding L[PublishToWorkshop]}" Command="{Binding PublishCommand}" Margin="0,0,8,6" />
        <TextBlock Classes="subheading" VerticalAlignment="Center" Margin="8,0,0,6" Text="{Binding L[DragRowsToChangeLoadOrder]}" />
      </WrapPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,150,100,125,90" Background="{StaticResource Dw2Steel}">
        <Button Classes="header" Grid.Column="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="0" Content="{Binding L[ModName]}" Padding="10,6" />
        <Button Classes="header" Grid.Column="1" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="1" Content="{Binding L[Source]}" />
        <Button Classes="header" Grid.Column="2" Command="{Binding SortCommand}" CommandParameter="2" Content="{Binding L[ModState]}" />
        <Button Classes="header" Grid.Column="3" Command="{Binding SortCommand}" CommandParameter="3" Content="{Binding L[Health]}" />
        <Button Classes="header" Grid.Column="4" Command="{Binding SortCommand}" CommandParameter="4" Content="{Binding L[LoadOrder]}" />
      </Grid>

      <Grid Grid.Row="2">
        <ListBox Name="ModList" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedRow}"
                 Background="{StaticResource Dw2Deep}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModRowViewModel">
              <Grid ColumnDefinitions="*,150,100,125,90" MinHeight="54">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="4,0">
                  <Image Source="{Binding Thumbnail}" Width="72" Height="48" Stretch="Uniform" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                <Button Classes="glyph" Classes.on="{Binding Enabled}" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding ToggleCommand}" CommandParameter="{Binding}" Content="{Binding StateGlyph}" />
                <TextBlock Grid.Column="3" Classes="health" Classes.conflict="{Binding IsConflict}" Classes.caution="{Binding IsCaution}" Classes.ok="{Binding IsOk}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Health}" />
                <TextBlock Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Dw2Gold}" Text="{Binding LoadOrder}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- Drag layer: the ghost of the row being dragged and the insertion line; never hit-tested. -->
        <Canvas Name="DragLayer" IsHitTestVisible="False" ClipToBounds="True">
          <Border Name="Ghost" IsVisible="False" Opacity="0.85" Background="{StaticResource Dw2Panel}"
                  BorderBrush="{StaticResource Dw2Gold}" BorderThickness="1">
            <Image Name="GhostImage" Stretch="None" />
          </Border>
          <Border Name="DropLine" IsVisible="False" Height="2" CornerRadius="1" Background="White" />
        </Canvas>
      </Grid>
    </Grid>

    <GridSplitter Grid.Column="1" Width="8" Background="Transparent" ResizeDirection="Columns" />

    <!-- Details -->
    <Border Grid.Column="2" Background="{StaticResource Dw2PanelAlt}" BorderBrush="{StaticResource Dw2Blue}" BorderThickness="1" Padding="14">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Border Grid.Row="0" Background="{StaticResource Dw2Void}" Height="240">
          <Image Source="{Binding Preview}" Stretch="Uniform" />
        </Border>
        <TextBlock Grid.Row="1" Classes="subheading" Margin="0,14,0,8" TextTrimming="CharacterEllipsis" Text="{Binding DetailTitle}" />
        <Border Grid.Row="2" IsVisible="{Binding HasProblems}" Classes="problems" Classes.conflict="{Binding ProblemsIsConflict}" Padding="10,8" Margin="0,0,0,8">
          <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding ProblemsText}" Foreground="{Binding $parent[Border].Tag}" />
        </Border>
        <ScrollViewer Grid.Row="3">
          <SelectableTextBlock TextWrapping="Wrap" Foreground="{StaticResource Dw2Muted}" Text="{Binding DetailText}" />
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
