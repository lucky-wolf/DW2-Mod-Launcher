<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DW2ModLauncher.Avalonia.ViewModels"
             xmlns:views="using:DW2ModLauncher.Avalonia.Views"
             x:Class="DW2ModLauncher.Avalonia.Views.ModsView"
             x:DataType="vm:MainViewModel">
  <Grid Name="RootGrid" Margin="14" Grid.IsSharedSizeScope="True">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="7*" MinWidth="380" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="3*" MinWidth="220" />
    </Grid.ColumnDefinitions>

    <!-- List. Its toolbar row shares a height with the empty row above the splitter and details pane, so they start level with the list. -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" SharedSizeGroup="Toolbar" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Name="ToolbarGrid" Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
        <Button Grid.Column="0" Command="{Binding RefreshCommand}" Margin="0,0,10,0" ToolTip.Tip="{Binding L[RefreshModsTooltip]}">
          <!-- "sync" icon (two circular arrows), Material Design Icons, Apache-2.0 -->
          <PathIcon Width="16" Height="16" Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" />
        </Button>
        <Button Grid.Column="1" Command="{Binding EnableAllCommand}" Margin="0,0,10,0" Padding="10,6" ToolTip.Tip="{Binding L[EnableAllModsTooltip]}">
          <!-- "playlist add check" icon, Material Design Icons, Apache-2.0 -->
          <PathIcon Width="16" Height="16" Data="M14 10H2v2h12v-2zm0-4H2v2h12V6zM2 16h8v-2H2v2zm19.5-4.5L23 13l-6.99 7-4.51-4.5L13 14l3.01 3 5.49-5.5z" />
        </Button>
        <Button Grid.Column="2" Command="{Binding ClearCommand}" Padding="10,6" ToolTip.Tip="{Binding L[ClearModListTooltip]}">
          <!-- "playlist remove" icon, Material Design Icons, Apache-2.0 -->
          <PathIcon Width="16" Height="16" Data="M14 10H3v2h11v-2zm0-4H3v2h11V6zM3 16h7v-2H3v2zm11.41 6L17 19.41 19.59 22 21 20.59 18.41 18 21 15.41 19.59 14 17 16.59 14.41 14 13 15.41 15.59 18 13 20.59 14.41 22z" />
        </Button>
        <TextBlock Grid.Column="3" Classes="subheading" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding L[DragRowsToChangeLoadOrder]}" />
        <Button Grid.Column="4" Command="{Binding ModSettingsCommand}" Margin="10,0,0,0" Padding="10,6" ToolTip.Tip="{Binding L[ModSettingsTooltip]}">
          <!-- "cog" icon, Material Design Icons, Apache-2.0 -->
          <PathIcon Width="16" Height="16" Data="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97 0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.08-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1 0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.29.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66z" />
        </Button>
        <Border Grid.Column="5" Width="1" Margin="10,2,0,2" Background="{StaticResource Dw2Muted}" />
        <Button Grid.Column="6" Command="{Binding CreateModCommand}" Margin="10,0,0,0" Padding="10,6" ToolTip.Tip="{Binding L[CreateModTooltip]}">
          <!-- "plus" icon, Material Design Icons, Apache-2.0 -->
          <PathIcon Width="16" Height="16" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
        </Button>
        <Button Grid.Column="7" Command="{Binding EditPropertiesCommand}" Margin="10,0,0,0" Padding="10,6" ToolTip.Tip="{Binding L[EditPropertiesTooltip]}">
          <!-- "pencil" icon, Material Design Icons, Apache-2.0 -->
          <PathIcon Width="16" Height="16" Data="M20.71 7.04c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83zM3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z" />
        </Button>
        <Button Grid.Column="8" Command="{Binding DeleteModCommand}" Margin="10,0,0,0" Padding="10,6" ToolTip.Tip="{Binding L[DeleteModTooltip]}">
          <!-- "trash" icon, Material Design Icons, Apache-2.0 -->
          <PathIcon Width="16" Height="16" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
        </Button>
        <Button Grid.Column="9" Command="{Binding PublishCommand}" Margin="10,0,0,0" Padding="10,6" ToolTip.Tip="{Binding L[PublishTooltip]}">
          <!-- "cloud upload" icon, Material Design Icons, Apache-2.0 -->
          <PathIcon Width="16" Height="16" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z" />
        </Button>
      </Grid>

      <!-- The headers can be dragged into any order (ModsView.axaml.cs); the rows below use the same order. -->
      <Grid Grid.Row="1">
        <views:ColumnRowPanel Name="HeaderPanel" Background="{StaticResource Dw2Steel}">
          <Button Classes="header" views:ColumnRowPanel.ColumnId="state" Command="{Binding SortCommand}" CommandParameter="4" Content="{Binding L[ModState]}" ToolTip.Tip="{Binding L[LoadOrder]}" />
          <Button Classes="header" views:ColumnRowPanel.ColumnId="name" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="0" Content="{Binding L[ModName]}" Padding="10,6" />
          <Button Classes="header" views:ColumnRowPanel.ColumnId="source" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="1" Content="{Binding L[Source]}" />
          <Button Classes="header" views:ColumnRowPanel.ColumnId="author" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="5" Content="{Binding L[Author]}" />
        </views:ColumnRowPanel>
        <Border Name="ColumnDropLine" IsVisible="False" IsHitTestVisible="False" Width="3" HorizontalAlignment="Left" Background="{StaticResource Dw2Gold}" />
      </Grid>

      <Grid Grid.Row="2">
        <ListBox Name="ModList" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedRow}"
                 Background="{StaticResource Dw2Deep}">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{Binding L[SteamPage]}" Command="{Binding OpenSteamPageCommand}" IsVisible="{Binding SelectedHasSteamPage}" />
              <MenuItem Header="{Binding L[ModSettings]}" Command="{Binding ModSettingsCommand}" />
              <MenuItem Header="{Binding L[SelectedModFolder]}" Command="{Binding OpenSelectedFolderCommand}" />
              <MenuItem Header="{Binding L[OpenDocs]}" Command="{Binding OpenDocsCommand}" />
              <MenuItem Header="{Binding L[EditProperties]}" Command="{Binding EditPropertiesCommand}" />
              <MenuItem Header="{Binding L[PublishToWorkshop]}" Command="{Binding PublishCommand}" />
              <MenuItem Header="{Binding L[DeleteMod]}" Command="{Binding DeleteModCommand}" />
              <Separator IsVisible="{Binding SelectedIsWorkshop}" />
              <MenuItem Header="{Binding L[CheckUpdates]}" Command="{Binding CheckUpdatesCommand}" IsVisible="{Binding SelectedIsWorkshop}" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModRowViewModel">
              <views:ColumnRowPanel MinHeight="54" Classes.off="{Binding !Enabled}">
                <StackPanel views:ColumnRowPanel.ColumnId="state" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Classes="glyph" Classes.on="{Binding Enabled}" Classes.caution="{Binding IsCaution}" Classes.conflict="{Binding IsConflict}" VerticalAlignment="Center"
                          Command="{Binding ToggleCommand}" CommandParameter="{Binding}" Content="{Binding StateGlyph}" ToolTip.Tip="{Binding HealthTip}" />
                  <TextBlock MinWidth="22" VerticalAlignment="Center" Foreground="{StaticResource Dw2Gold}" Text="{Binding LoadOrderNumber}" />
                </StackPanel>
                <StackPanel views:ColumnRowPanel.ColumnId="name" Classes="dim" Orientation="Horizontal" Spacing="8" Margin="4,0">
                  <Image Source="{Binding Thumbnail}" Width="72" Height="48" Stretch="Uniform" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="●" VerticalAlignment="Center" Foreground="{StaticResource Dw2Gold}" IsVisible="{Binding HasUnpublishedChanges}" ToolTip.Tip="{Binding UnpublishedTip}" />
                </StackPanel>
                <StackPanel views:ColumnRowPanel.ColumnId="source" Classes="dim" Margin="6,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                    <Panel IsVisible="{Binding HasVisibility}" VerticalAlignment="Center" ToolTip.Tip="{Binding VisibilityTip}">
                      <!-- Visibility icons, Material Design Icons, Apache-2.0: eye = public, eye with slash = private, people = friends only, link = unlisted, cloud with slash = not published -->
                      <PathIcon IsVisible="{Binding IsVisPublic}" Width="14" Height="14" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                      <PathIcon IsVisible="{Binding IsVisPrivate}" Width="14" Height="14" Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z" />
                      <PathIcon IsVisible="{Binding IsVisFriends}" Width="14" Height="14" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                      <PathIcon IsVisible="{Binding IsVisUnlisted}" Width="14" Height="14" Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z" />
                      <PathIcon IsVisible="{Binding IsNotPublished}" Width="14" Height="14" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4c-1.48 0-2.85.43-4.01 1.17l1.46 1.46C10.21 6.23 11.08 6 12 6c3.04 0 5.5 2.46 5.5 5.5v.5H19c1.66 0 3 1.34 3 3 0 1.13-.64 2.11-1.56 2.62l1.45 1.45C23.16 18.16 24 16.68 24 15c0-2.64-2.05-4.78-4.65-4.96zM3 5.27l2.75 2.74C2.56 8.15 0 10.77 0 14c0 3.31 2.69 6 6 6h11.73l2 2L21 20.73 4.27 4 3 5.27zM7.73 10l8 8H6c-2.21 0-4-1.79-4-4s1.79-4 4-4h1.73z" />
                    </Panel>
                  </StackPanel>
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding FolderPath}" IsVisible="{Binding HasFolderPath}" TextTrimming="PathSegmentEllipsis" />
                </StackPanel>
                <TextBlock views:ColumnRowPanel.ColumnId="author" Classes="dim" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Author}" />
              </views:ColumnRowPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- Drag layer: the ghost of the row being dragged and the insertion line; never hit-tested. -->
        <Canvas Name="DragLayer" IsHitTestVisible="False" ClipToBounds="True">
          <Border Name="Ghost" IsVisible="False" Opacity="0.85" Background="{StaticResource Dw2Panel}"
                  BorderBrush="{StaticResource Dw2Gold}" BorderThickness="1">
            <Image Name="GhostImage" Stretch="None" />
          </Border>
          <Border Name="DropLine" IsVisible="False" Height="2" CornerRadius="1" Background="White" />
        </Canvas>
      </Grid>
    </Grid>

    <!-- A GridSplitter resizes the columns of its own parent grid, so it sits directly in RootGrid; its top margin (set in code)
         keeps it level with the list, below the toolbar row. -->
    <GridSplitter Name="DetailsSplitter" Grid.Column="1" Width="14" Background="Transparent" ResizeDirection="Columns" />

    <!-- Collapse / expand the details pane: top right, on the toolbar's row; stays put when the pane is gone. -->
    <Button Name="DetailsToggle" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,6" ToolTip.Tip="{Binding L[ToggleDetailsTooltip]}">
      <PathIcon Name="DetailsToggleIcon" Width="16" Height="16" Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" />
    </Button>

    <!-- Details -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" SharedSizeGroup="Toolbar" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
    <Border Name="DetailsPane" Grid.Row="1" Background="{StaticResource Dw2PanelAlt}" BorderBrush="{StaticResource Dw2Blue}" BorderThickness="1" Padding="14">
      <Panel>
      <TextBlock IsVisible="{Binding !HasSelection}" Text="{Binding L[SelectModForDetails]}" Foreground="{StaticResource Dw2Gold}"
                 FontSize="18" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
        <Border Name="PreviewBorder" Grid.Row="0" Background="{StaticResource Dw2Void}" Height="240">
          <Image Source="{Binding Preview}" Stretch="Uniform" Cursor="Hand" />
        </Border>
        <TextBlock Grid.Row="1" Classes="subheading" Margin="0,14,0,8" TextTrimming="CharacterEllipsis" Text="{Binding DetailTitle}" />
        <StackPanel Grid.Row="2" Spacing="2" Margin="0,0,0,10">
          <SelectableTextBlock Foreground="{StaticResource Dw2Muted}" TextWrapping="Wrap" Text="{Binding DetailWorkshopId}" />
          <SelectableTextBlock Foreground="{StaticResource Dw2Muted}" TextWrapping="Wrap" Text="{Binding DetailSource}" />
          <SelectableTextBlock IsVisible="{Binding HasPublishState}" Foreground="{StaticResource Dw2Muted}" TextWrapping="Wrap" Text="{Binding DetailPublishState}" ToolTip.Tip="{Binding DetailPublishTip}" />
          <SelectableTextBlock IsVisible="{Binding HasVisibility}" Foreground="{StaticResource Dw2Muted}" TextWrapping="Wrap" Text="{Binding DetailVisibility}" />
        </StackPanel>
        <Border Grid.Row="3" IsVisible="{Binding HasProblems}" Classes="problems" Classes.conflict="{Binding ProblemsIsConflict}" Padding="10,8" Margin="0,0,0,8">
          <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding ProblemsText}" Foreground="{Binding $parent[Border].Tag}" />
        </Border>
        <SelectableTextBlock Grid.Row="4" IsVisible="{Binding HasLinks}" TextWrapping="Wrap" Foreground="{StaticResource Dw2Muted}" Margin="0,0,0,10"
                             Text="{Binding DetailLinks}" />
        <Border Grid.Row="5" Height="1" Background="{StaticResource Dw2Blue}" Margin="0,0,0,10" />
        <ScrollViewer Grid.Row="6">
          <SelectableTextBlock TextWrapping="Wrap" Foreground="{StaticResource Dw2Muted}" Text="{Binding DetailText}" />
        </ScrollViewer>
      </Grid>
      </Panel>
    </Border>
    </Grid>
  </Grid>
</UserControl>
