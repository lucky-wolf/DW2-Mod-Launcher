<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DW2ModLauncher.Avalonia.Views.StepsDialog"
        SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">
  <StackPanel Margin="24" Spacing="18">
    <StackPanel Name="Rows" Spacing="14" HorizontalAlignment="Center" />
    <Button Name="CancelButton" IsVisible="False" HorizontalAlignment="Center" MinWidth="110" />
  </StackPanel>
</Window>
