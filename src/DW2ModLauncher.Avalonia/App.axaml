<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DW2ModLauncher.Avalonia.ViewModels"
             x:Class="DW2ModLauncher.Avalonia.App"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <!-- A setting's tooltip when the mod gave it a preview image (settings.schema.json "_previews"): the image, a note when it could not be shown, then the description. -->
    <DataTemplate DataType="vm:SettingPreviewTip" x:DataType="vm:SettingPreviewTip">
      <StackPanel Spacing="6" MaxWidth="960">
        <Image IsVisible="{Binding HasImage}" Source="{Binding Image}" MaxWidth="960" MaxHeight="640" Stretch="Uniform" />
        <TextBlock IsVisible="{Binding HasProblem}" Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{StaticResource Dw2Gold}" />
        <TextBlock IsVisible="{Binding HasDescription}" Text="{Binding Description}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DW2ModLauncher/Styles/Dw2.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://DW2ModLauncher/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
