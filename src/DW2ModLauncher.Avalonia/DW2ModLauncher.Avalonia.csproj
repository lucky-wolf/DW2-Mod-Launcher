<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DW2ModLauncher.Avalonia</RootNamespace>
    <AssemblyName>DW2ModLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DW2ModLauncher.Core\DW2ModLauncher.Core.csproj" />
    <!-- Not linked in: this ships as the standalone DLL the launcher injects via the game's
         low level inject flag (see GameLauncher.LoaderDllPath). ReferenceOutputAssembly=false
         keeps it out of this project's own dependency closure; the targets below copy its build
         output into our own output folder's Loader\ subfolder. -->
    <ProjectReference Include="..\DW2ModLauncher.Loader\DW2ModLauncher.Loader.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <IsLinuxTarget Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">true</IsLinuxTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tells the Steamworks API which app this non-Steam-launched process is acting as. -->
    <Content Include="steam_appid.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Native Steam API library, per OS. Linux: Valve's libsteam_api.so, vendored as a matched pair with
         Steamworks.NET.dll (see third_party/steamworks/README.md). Windows: the matching steam_api64.dll from the same revision. -->
    <None Condition="'$(IsLinuxTarget)' == 'true'" Include="..\..\third_party\steamworks\linux-x64\libsteam_api.so">
      <Link>libsteam_api.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Condition="'$(IsLinuxTarget)' == 'true'" Include="..\..\third_party\steamworks\linux-x64\Steamworks.NET.dll">
      <Link>Steamworks.NET.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Condition="'$(IsLinuxTarget)' != 'true'" Include="..\..\third_party\steamworks\win-x64\steam_api64.dll">
      <Link>steam_api64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Condition="'$(IsLinuxTarget)' != 'true'" Include="..\..\third_party\steamworks\win-x64\Steamworks.NET.dll">
      <Link>Steamworks.NET.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Languages\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyLoaderOutput" AfterTargets="Build">
    <MSBuild Projects="..\DW2ModLauncher.Loader\DW2ModLauncher.Loader.csproj" Targets="Build" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="LoaderBuildOutputs" />
    </MSBuild>
    <ItemGroup>
      <LoaderFiles Include="..\DW2ModLauncher.Loader\bin\$(Configuration)\net8.0\DW2ModLauncher.Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(LoaderFiles)" DestinationFolder="$(OutDir)Loader" SkipUnchangedFiles="true" />
  </Target>

  <!-- dotnet publish only ships Content/None-with-CopyToPublishDirectory items, so the Loader DLL that
       CopyLoaderOutput drops into the build output must be added to the publish list explicitly. -->
  <Target Name="AddLoaderToPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="..\DW2ModLauncher.Loader\bin\$(Configuration)\net8.0\DW2ModLauncher.Loader.dll">
        <RelativePath>Loader\DW2ModLauncher.Loader.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <!-- The game loads this by path, so it must stay a loose file, not get bundled into the exe. -->
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
