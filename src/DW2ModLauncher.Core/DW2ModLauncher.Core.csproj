<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DW2ModLauncher.Core</RootNamespace>
    <AssemblyName>DW2ModLauncher.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vendored, not NuGet: the NuGet package (SDK 1.60) doesn't match the 1.65 native library - see third_party/steamworks/README.md. -->
    <!-- Compile-time only: there is one wrapper build per OS (struct packing differs, see the README), and the
         executable projects copy the matching one next to themselves. -->
    <Reference Include="Steamworks.NET">
      <HintPath>..\..\third_party\steamworks\win-x64\Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- XML patching: the localization generator reuses the patch engine's key map. -->
    <ProjectReference Include="..\DW2ModLauncher.XmlPatching\DW2ModLauncher.XmlPatching.csproj" />
  </ItemGroup>

</Project>
