<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DW2ModLauncher.Core</RootNamespace>
    <AssemblyName>DW2ModLauncher.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Facepunch.Steamworks" Version="2.3.3" />
    <!-- Vendored, not NuGet: the NuGet package (SDK 1.60) doesn't match the 1.65 native library - see third_party/steamworks/README.md. -->
    <Reference Include="Steamworks.NET">
      <HintPath>..\..\third_party\steamworks\linux-x64\Steamworks.NET.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Facepunch.Steamworks (Windows publisher) and Steamworks.NET (Linux publisher) both declare a
       Steamworks.SteamClient type, so Facepunch is reached through the "facepunch" extern alias.
       Temporary: drops out once Windows publishing moves to Steamworks.NET too. -->
  <Target Name="AliasFacepunchSteamworks" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(Filename)' == 'Facepunch.Steamworks.Win64'">
        <Aliases>facepunch</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

</Project>
